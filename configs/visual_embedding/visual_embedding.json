{
  "backend": "open_clip",
  "model": "ViT-B-32",
  "pretrained": "laion2b_s34b_b79k",
  "model_cache_env": "METHADATA_MODEL_CACHE",
  "icon_max_side": 256,
  "crop_rules": [
    "whole",
    "grid2x2",
    "center50"
  ],
  "center_area": 0.5,
  "min_crop_side": 64,
  "max_images": 8,
  "cos_floor": 0.5,
  "cos_hit": 0.8,
  "cross_lo": 0.15,
  "cross_hi": 0.35,
  "vec_decimals": 5
}