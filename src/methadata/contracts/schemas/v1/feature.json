{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Odwołanie do artefaktu, opcjonalnie do jego fragmentu. Bez locator = cały artefakt.",
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "byte_range": "#/$defs/ByteRange",
                  "har_entry": "#/$defs/HarEntry",
                  "image_rect": "#/$defs/ImageRect",
                  "text_span": "#/$defs/TextSpan"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextSpan"
                },
                {
                  "$ref": "#/$defs/ImageRect"
                },
                {
                  "$ref": "#/$defs/HarEntry"
                },
                {
                  "$ref": "#/$defs/ByteRange"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ByteRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "kind": {
          "const": "byte_range",
          "default": "byte_range",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ByteRange",
      "type": "object"
    },
    "HarEntry": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "har_entry",
          "default": "har_entry",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "index"
      ],
      "title": "HarEntry",
      "type": "object"
    },
    "ImageRect": {
      "additionalProperties": false,
      "properties": {
        "frame_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Ms"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "kind": {
          "const": "image_rect",
          "default": "image_rect",
          "title": "Kind",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "ImageRect",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "kind": {
          "const": "text_span",
          "default": "text_span",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpan",
      "type": "object"
    },
    "ValueType": {
      "enum": [
        "string",
        "number",
        "boolean",
        "string_list",
        "json",
        "vector"
      ],
      "title": "ValueType",
      "type": "string"
    },
    "VectorRef": {
      "additionalProperties": false,
      "properties": {
        "dim": {
          "exclusiveMinimum": 0,
          "title": "Dim",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "ref",
        "index",
        "model",
        "model_version",
        "dim"
      ],
      "title": "VectorRef",
      "type": "object"
    }
  },
  "$id": "https://methadata.local/schemas/v1/feature.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "extractor_version": {
      "minLength": 1,
      "title": "Extractor Version",
      "type": "string"
    },
    "family": {
      "minLength": 1,
      "title": "Family",
      "type": "string"
    },
    "feature_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
      "title": "Feature Id",
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "observation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
      "title": "Observation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "value": {
      "default": null,
      "title": "Value"
    },
    "value_type": {
      "$ref": "#/$defs/ValueType"
    },
    "vector_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VectorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "feature_id",
    "observation_id",
    "family",
    "kind",
    "value_type",
    "extractor_version"
  ],
  "title": "Feature",
  "type": "object"
}
