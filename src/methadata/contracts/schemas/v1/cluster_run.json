{
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "cluster_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
            "type": "string"
          },
          "title": "Cluster Ids",
          "type": "array"
        },
        "material_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
          "title": "Material Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssignmentStatus"
        }
      },
      "required": [
        "material_id",
        "status"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "AssignmentStatus": {
      "enum": [
        "grouped",
        "singleton",
        "noise",
        "insufficient_data"
      ],
      "title": "AssignmentStatus",
      "type": "string"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "pair_evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
          "title": "Pair Evidence Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "source",
        "target",
        "relation",
        "pair_evidence_id"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Relation": {
      "enum": [
        "duplicate_capture",
        "shared_template",
        "shared_narrative",
        "campaign_candidate"
      ],
      "title": "Relation",
      "type": "string"
    }
  },
  "$id": "https://methadata.local/schemas/v1/cluster_run.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "title": "Assignments",
      "type": "array"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "method_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
      "title": "Method Id",
      "type": "string"
    },
    "method_version": {
      "minLength": 1,
      "title": "Method Version",
      "type": "string"
    },
    "relation": {
      "$ref": "#/$defs/Relation"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "dataset_version",
    "method_id",
    "method_version",
    "seed",
    "relation",
    "assignments"
  ],
  "title": "ClusterRun",
  "type": "object"
}
