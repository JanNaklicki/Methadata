{
  "$defs": {
    "ExtractionState": {
      "enum": [
        "ok",
        "missing_input",
        "failed",
        "unsupported"
      ],
      "title": "ExtractionState",
      "type": "string"
    }
  },
  "$id": "https://methadata.local/schemas/v1/extraction_status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "extractor_version": {
      "minLength": 1,
      "title": "Extractor Version",
      "type": "string"
    },
    "observation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$",
      "title": "Observation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ExtractionState"
    }
  },
  "required": [
    "observation_id",
    "extractor_version",
    "state"
  ],
  "title": "ExtractionStatus",
  "type": "object"
}
